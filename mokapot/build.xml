<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Mokapot — JavaCard 3.0.5 applet build using SDK 3.2.0v25.1
  Uses ant-javacard: https://github.com/martinpaljak/ant-javacard
  ant-javacard.jar is downloaded automatically on first build (skipexisting).

  Build:   ant build
  Install: gp -install build/mokapot.cap
-->
<project
    name="mokapot"
    default="build"
    basedir="."
    xmlns:ivy="antlib:org.apache.ivy.ant"
>

    <property
        name="ant.javacard.jar"
        value="${basedir}/util/ant-javacard.jar"
    />

    <property name="applet.rid" value="CAFE4D6F6B61" />
    <property name="applet.aid" value="CAFE4D6F6B61000100000000000000" />

    <!-- JavaCard SDK path from environment variable -->
    <property name="jckit" value="${env.JC_HOME}" />


    <taskdef
        resource="org/apache/ivy/ant/antlib.xml"
        uri="antlib:org.apache.ivy.ant"
    >
        <classpath>
            <pathelement location="ivy/ivy-2.5.3.jar" />
            <fileset dir="ivy/lib">
                <include name="*.jar" />
            </fileset>
        </classpath>
    </taskdef>



    <!-- Test dependency directories -->
    <property name="test.lib.dir" value="${basedir}/lib/test" />

    <target name="fetch" description="Download ant-javacard.jar if not present">
        <mkdir dir="${basedir}/util" />
        <get
            src="https://github.com/martinpaljak/ant-javacard/releases/latest/download/ant-javacard.jar"
            dest="${basedir}/util/ant-javacard.jar"
            skipexisting="true"
        />
    </target>

    <target
        name="resolve-test"
        description="Resolve test dependencies with Ivy"
    >
        <ivy:resolve conf="test" />
        <ivy:cachepath pathid="test.classpath" conf="test" />
        <ivy:retrieve
            pattern="${test.lib.dir}/[artifact]-[revision].[ext]"
            conf="test"
        />
    </target>

    <!--
      compile-tests: compiles applet sources + test sources against JCardEngine.
      JCardEngine bundles the JavaCard API classes, so no separate SDK is needed
      for test compilation — only for the cap-conversion build target above.
    -->
    <target
        name="compile-tests"
        depends="resolve-test"
        description="Compile applet and test sources against JCardEngine"
    >
        <mkdir dir="${basedir}/build/test-classes" />
        <!-- Applet sources compiled against JCardEngine's JavaCard API -->
        <javac
            srcdir="${basedir}/src/main/java"
            destdir="${basedir}/build/test-classes"
            includeantruntime="false"
        >
            <classpath refid="test.classpath" />
        </javac>
        <!-- Test sources compiled against JCardEngine + compiled applet classes -->
        <javac
            srcdir="${basedir}/src/test/java"
            destdir="${basedir}/build/test-classes"
            includeantruntime="false"
        >
            <classpath>
                <path refid="test.classpath" />
                <pathelement path="${basedir}/build/test-classes" />
            </classpath>
        </javac>
    </target>

    <!--
      test: runs JUnit via JUnitCore (no ant-junit.jar required).
      JCardEngine simulates the JavaCard runtime in-process.
    -->
    <target
        name="test"
        depends="compile-tests"
        description="Run applet tests with JCardEngine"
    >
        <java
            classname="org.junit.runner.JUnitCore"
            fork="true"
            failonerror="true"
        >
            <classpath>
                <path refid="test.classpath" />
                <pathelement path="${basedir}/build/test-classes" />
            </classpath>
            <arg value="com.espressho.mokapot.SSHKeyAppletTest" />
        </java>
    </target>

    <target name="build" depends="fetch" description="Build mokapot.cap">
        <mkdir dir="${basedir}/build" />
        <taskdef
            name="javacard"
            classname="pro.javacard.ant.JavaCard"
            classpath="${ant.javacard.jar}"
        />
        <javacard>
            <cap
                targetsdk="3.0.5"
                aid="${applet.rid}"
                package="com.espressho.mokapot"
                version="1.0"
                output="${basedir}/build/mokapot-%v.cap"
            >
                <applet
                    class="com.espressho.mokapot.SSHKeyApplet"
                    aid="${applet.aid}"
                />
            </cap>
            <cap
                aid="${applet.rid}"
                targetsdk="3.0.5"
                package="com.espressho.mokapot"
                version="1.0"
                output="${basedir}/build/mokapot-release-%v.cap"
                strip="true"
                debug="false"
            >
                <applet
                    class="com.espressho.mokapot.SSHKeyApplet"
                    aid="${applet.aid}"
                />
            </cap>

        </javacard>
    </target>

    <target name="clean-ivy" description="Clean ivy cache and dependencies">
        <ivy:cleancache />
        <delete dir="${test.lib.dir}" />
    </target>

    <target name="clean" description="Remove build output and dependencies">
        <delete dir="${basedir}/build" />
        <delete dir="${test.lib.dir}" />
    </target>

</project>
